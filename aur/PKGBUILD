# Maintainer: Sebastien WALD <contact@sebastien-wald.fr>
pkgname=klc-light
pkgver=0.5.1
pkgrel=1
pkgdesc='Per-key RGB lighting editor for MSI laptops with a SteelSeries KLC keyboard, made for Omarchy'
arch=('x86_64')
url='https://github.com/swald54000/klc-light'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hidapi' 'libxkbcommon' 'systemd' 'gcc-libs' 'glibc')
install=klc-light.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fc54c2796d12460b4076ed0190a158da116a03007cbaf38b35c9d4359b952744')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/klc-light "$pkgdir/usr/bin/klc-light"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/klc-light.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/klc-light.svg"
  install -Dm644 pkgbuild/klc-light.desktop "$pkgdir/usr/share/applications/klc-light.desktop"
  install -Dm644 pkgbuild/70-klc-light.rules "$pkgdir/usr/lib/udev/rules.d/70-klc-light.rules"
  install -Dm644 pkgbuild/klc-light.sysusers "$pkgdir/usr/lib/sysusers.d/klc-light.conf"
}
