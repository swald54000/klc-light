<RCC>
    <qresource prefix="/">
        <file alias="Main.qml">Main.qml</file>
        <file alias="KeyboardView.qml">KeyboardView.qml</file>
        <file alias="LayerList.qml">LayerList.qml</file>
        <file alias="EffectPanel.qml">EffectPanel.qml</file>
        <file alias="ColorPicker.qml">ColorPicker.qml</file>
        <file alias="FlatComboBox.qml">FlatComboBox.qml</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/fr.json">i18n/fr.json</file>
        <file alias="presets/aqua.json">presets/aqua.json</file>
    </qresource>
</RCC>
